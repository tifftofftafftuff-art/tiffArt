# Web3Forms access key for the contact form.
# Get one at https://web3forms.com — it is safe to expose client-side
# (the PUBLIC_ prefix makes Astro inline it into the built HTML).
# Without it, the contact page shows a fallback message instead of the form.
PUBLIC_WEB3FORMS_KEY=

# Optional: canonical site URL (enables sitemap, canonical + og:url tags).
# Set this as a build variable in the Cloudflare dashboard once the
# *.workers.dev URL (or a custom domain) is known. Not needed for local dev.
# SITE_URL=
