---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { parseVideoUrl } from '../lib/video';

const siteEntry = await getEntry('site', 'index');
const site = siteEntry!.data;

const videoEntries = await getCollection('videos');
const videos = await Promise.all(
  [...videoEntries]
    .sort((a, b) => a.data.sortOrder - b.data.sortOrder || a.data.title.localeCompare(b.data.title))
    .map(async (entry) => {
      const { Content } = await render(entry);
      return {
        entry,
        embed: parseVideoUrl(entry.data.url),
        Content,
        hasNote: Boolean(entry.body?.trim()),
      };
    }),
);

const description = `Streams, reels, and other moving pictures by ${site.artistName}`;
---

<BaseLayout title="Videos" description={description}>
  <h1>videos</h1>
  {
    videos.length === 0 ? (
      <div class="prose">
        <p>nothing here yet — check back soon ☆</p>
      </div>
    ) : (
      <ul class="gallery-grid">
        {videos.map(({ entry, embed, Content, hasNote }) => (
          <li class="artwork-card video-card">
            {embed.kind === 'iframe' && (
              <div class={`video-frame video-frame--${embed.aspect}`}>
                <iframe
                  src={embed.src}
                  title={entry.data.title}
                  loading="lazy"
                  allowfullscreen
                  allow="autoplay; encrypted-media; picture-in-picture"
                />
              </div>
            )}
            {embed.kind === 'twitch' && (
              <div
                class="video-frame video-frame--wide"
                data-twitch={embed.params}
                data-title={entry.data.title}
              >
                <a class="video-link-chip" href={entry.data.url} rel="noopener">
                  watch on twitch ↗
                </a>
              </div>
            )}
            {embed.kind === 'link' && (
              <a class="video-link-chip" href={entry.data.url} rel="noopener">
                watch ↗
              </a>
            )}
            <p class="artwork-card-caption">
              <span class="artwork-card-title">{entry.data.title}</span>
            </p>
            {hasNote && (
              <div class="video-note">
                <Content />
              </div>
            )}
          </li>
        ))}
      </ul>
    )
  }

  <script is:inline>
    // Twitch's player requires a `parent` param matching the live domain,
    // which only the browser knows on a static site. With JS disabled the
    // "watch on twitch" link stays in place instead.
    //
    // Channel embeds are smart: /api/twitch/latest reports live status and
    // the newest VOD, so an offline channel shows the latest broadcast
    // instead of Twitch's offline card. If that endpoint isn't configured
    // (or errors), the plain channel embed is used.
    (async () => {
      const els = [...document.querySelectorAll('[data-twitch]')];
      if (!els.length) return;

      let latest = null;
      if (els.some((el) => el.getAttribute('data-twitch').startsWith('channel='))) {
        try {
          const res = await fetch('/api/twitch/latest');
          if (res.ok) latest = await res.json();
        } catch {}
      }

      els.forEach((el) => {
        let params = el.getAttribute('data-twitch');
        if (
          params.startsWith('channel=') &&
          latest?.configured &&
          !latest.live &&
          latest.vodId
        ) {
          params = `video=${latest.vodId}`;
        }
        const base = params.startsWith('clip=')
          ? 'https://clips.twitch.tv/embed'
          : 'https://player.twitch.tv/';
        const iframe = document.createElement('iframe');
        iframe.src = `${base}?${params}&parent=${location.hostname}&autoplay=false`;
        iframe.title = el.getAttribute('data-title') || 'Twitch player';
        iframe.loading = 'lazy';
        iframe.allowFullscreen = true;
        el.replaceChildren(iframe);
      });
    })();
  </script>
</BaseLayout>
