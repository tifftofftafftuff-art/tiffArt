---
/**
 * Plain HTML form posting straight to Web3Forms — works with JavaScript
 * disabled. The only JS is progressive enhancement: it adds a `redirect`
 * field so successful submissions land back on this site's /thanks/ page.
 * Without JS, Web3Forms shows its own hosted success page instead.
 *
 * When PUBLIC_WEB3FORMS_KEY is not set, the form is replaced with a clear
 * fallback message rather than posting into the void.
 */
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;

interface Props {
  email?: string | undefined;
}

const { email } = Astro.props;
---

{
  accessKey ? (
    <form
      class="contact-form"
      action="https://api.web3forms.com/submit"
      method="POST"
    >
      <input type="hidden" name="access_key" value={accessKey} />
      <input type="hidden" name="subject" value="New message from the portfolio site" />
      <input type="hidden" name="from_name" value="Portfolio contact form" />
      {/* Honeypot — hidden from people, filled in by naive bots. */}
      <div class="honeypot-field" aria-hidden="true">
        <label>
          Leave this field empty
          <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
        </label>
      </div>
      <div class="form-field">
        <label for="contact-name">Name</label>
        <input id="contact-name" type="text" name="name" required autocomplete="name" />
      </div>
      <div class="form-field">
        <label for="contact-email">Email</label>
        <input id="contact-email" type="email" name="email" required autocomplete="email" />
      </div>
      <div class="form-field">
        <label for="contact-message">Message</label>
        <textarea id="contact-message" name="message" rows="6" required></textarea>
      </div>
      <button type="submit">Send message</button>
      <script is:inline>
        // Progressive enhancement: return to our own thank-you page after a
        // successful submission. Uses the live origin, so it works on
        // *.pages.dev and any future domain without configuration.
        const form = document.currentScript?.closest('form');
        if (form) {
          const redirect = document.createElement('input');
          redirect.type = 'hidden';
          redirect.name = 'redirect';
          redirect.value = new URL('/thanks/', window.location.origin).href;
          form.append(redirect);
        }
      </script>
    </form>
  ) : (
    <p class="form-note">
      The contact form isn't configured yet (missing the
      <code>PUBLIC_WEB3FORMS_KEY</code> environment variable).
      {email ? (
        <>
          {' '}In the meantime, email <a href={`mailto:${email}`}>{email}</a> directly.
        </>
      ) : null}
    </p>
  )
}
